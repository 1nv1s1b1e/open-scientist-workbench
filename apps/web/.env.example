# Local development
# Backend API base URL (apps/api Nitro dev server). The Next.js dev server
# proxies /api/* to this URL via next.config.ts rewrites, keeping the browser
# same-origin so no CORS is needed on the backend.
API_BASE_URL=http://localhost:3000

# When deployed standalone (no reverse proxy), set this to the public API URL
# and remove the rewrite in next.config.ts.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
