{
  "name": "open-scientist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @open-scientist/api dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @open-scientist/storage db:generate",
    "db:migrate": "pnpm --filter @open-scientist/storage db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "just-bash": "^3.1.0"
  }
}
